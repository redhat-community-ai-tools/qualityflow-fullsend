{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualityFlow PR QE Review Result",
  "description": "Output of the qualityflow-reviewer agent: per-requirement test coverage findings on a pull request. Validated by the harness validation_loop before the post-script posts the comment.",
  "type": "object",
  "required": [
    "status",
    "repo",
    "pr_number"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ]
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "work_item": {
      "type": "string",
      "description": "Jira key (PROJ-123) or GitHub issue reference (#456) the PR was reviewed against"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVED",
        "APPROVED_WITH_FINDINGS",
        "NEEDS_REVISION"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "coverage_signal": {
      "type": "string",
      "enum": [
        "measured",
        "static"
      ],
      "description": "measured = a coverage report was available; static = reachability only. LOW/MEDIUM confidence is expected when static."
    },
    "escalate": {
      "type": "boolean",
      "description": "True when the gap warrants the full /fs-plan-tests pipeline"
    },
    "requirements": {
      "type": "object",
      "required": [
        "total",
        "covered",
        "partial",
        "uncovered",
        "unimplemented"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "requirement_id",
              "statement",
              "source",
              "status"
            ],
            "properties": {
              "requirement_id": {
                "type": "string"
              },
              "statement": {
                "type": "string",
                "minLength": 5,
                "maxLength": 500
              },
              "source": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "covered",
                  "partial",
                  "uncovered",
                  "unimplemented"
                ]
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "string",
                "description": "What the reviewer read to reach this status"
              }
            }
          }
        },
        "unimplemented": {
          "type": "integer",
          "minimum": 0,
          "description": "Requirements whose implementing code is absent from this PR. total = covered + partial + uncovered + unimplemented"
        }
      }
    },
    "findings": {
      "type": "object",
      "required": [
        "critical",
        "major",
        "minor",
        "actionable",
        "total"
      ],
      "properties": {
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "actionable": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings beyond the 25 reported in the comment"
        },
        "items": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "severity",
              "dimension",
              "description",
              "remediation",
              "actionable"
            ],
            "properties": {
              "finding_id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "CRITICAL",
                  "MAJOR",
                  "MINOR"
                ]
              },
              "dimension": {
                "type": "string",
                "enum": [
                  "requirement_coverage",
                  "coverage_gap",
                  "scenario_quality",
                  "test_level",
                  "rule_compliance",
                  "scope_gap"
                ]
              },
              "requirement_ref": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "maxLength": 2000
              },
              "remediation": {
                "type": "string",
                "minLength": 10,
                "maxLength": 2000
              },
              "evidence": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "lines": {
                "type": "string",
                "pattern": "^\\d+(-\\d+)?$",
                "description": "Omit when working from a diff \u2014 hunk headers do not give reliable per-finding line numbers"
              },
              "actionable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "report": {
      "type": "string",
      "description": "Filename of the markdown report in the output dir, posted as the PR comment"
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "error"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "reason"
    ],
    "properties": {
      "reason": {
        "type": "string",
        "enum": [
          "no-linked-work-item",
          "work-item-unavailable",
          "no-code-changes",
          "config-error",
          "timeout"
        ]
      }
    }
  },
  "else": {
    "required": [
      "verdict",
      "confidence",
      "coverage_signal",
      "requirements",
      "findings",
      "report"
    ]
  }
}
