+// envLast returns the last-wins value of key in an exec env slice, matching
+// os/exec's duplicate-key rule used by postScriptEnv.
+func envLast(env []string, key string) string {
+	prefix := key + "="
+	val := ""
+	for _, e := range env {
+		if strings.HasPrefix(e, prefix) {
+			val = e[len(prefix):]
+		}
+	}
+	return val
+}
